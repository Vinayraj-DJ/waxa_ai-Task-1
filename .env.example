# CognoDB Cloud (Primary Subject)
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password

# Neo4j (Aura Cloud / Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Memgraph (Cloud / Docker)
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=memgraph

# FalkorDB / RedisGraph (Cloud / Docker)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ArangoDB (Cloud / Docker)
ARANGODB_URL=http://localhost:8529
ARANGODB_DB=_system
ARANGODB_USER=root
ARANGODB_PASSWORD=password123

# General Benchmark Options
BENCHMARK_ITERATIONS=100
CONCURRENCY_LEVELS=1,10,20,40
BATCH_SIZE=1000
DATASET_NODES=10000
DATASET_EDGES=100000
